# Copy to backend/.env or the project-root .env.
# Do not commit a real password or JWT secret.

# development | production
APP_ENV=development

DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/scheme_predictor
# TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/scheme_predictor_test

# Academic development fallback is rejected when APP_ENV=production.
JWT_SECRET_KEY=change-me-academic-prototype-only-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Sign-In. Use the same Web client ID as VITE_GOOGLE_CLIENT_ID.
# Do not put a Google client secret in the React app.
# Required when APP_ENV=production.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Comma-separated browser origins. Required when APP_ENV=production. Do not use *.
# Development also allows http://localhost:5173 and http://127.0.0.1:5173.
# CORS_ALLOWED_ORIGINS=https://schemewise.example.edu

# Optional comma-separated emails granted the administrator role.
# Uses the existing JWT login. Do not treat this as a second authentication system.
# ADMIN_EMAILS=admin@example.com

# Optional cloud speech-to-text for Tamil. Leave unset to keep browser STT.
# Audio is never stored. Production requires HTTPS when this is enabled.
# VOICE_STT_API_URL=https://speech.example.edu/transcribe
# VOICE_STT_API_KEY=

# In-process auth rate limit. Enabled in production. Not a Redis gateway.
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT=10
# AUTH_RATE_WINDOW_SECONDS=60
