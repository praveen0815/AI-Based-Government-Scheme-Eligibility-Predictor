# Copy to .env for local configuration.
# Do not put real passwords or API keys in this file.
# Do not commit .env.

# development | production
APP_ENV=development

# Application PostgreSQL database. Use placeholders, not a real password in git.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/scheme_predictor

# Separate database for automated tests. Do not point this at the development wallet database.
# TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/scheme_predictor_test

# Optional. Path to the saved Decision Tree, relative to the project root.
# MODEL_ARTIFACT_PATH=ml/models/baseline/decision_tree.joblib

# Optional. Path to the official scheme catalog, relative to the project root.
# SCHEME_CATALOG_PATH=dataset/raw/schemes.csv

# Academic prototype JWT settings. Do not commit a real secret.
JWT_SECRET_KEY=change-me-academic-prototype-only-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional comma-separated emails granted the administrator role.
# ADMIN_EMAILS=admin@example.com

# Optional cloud speech-to-text for Tamil. Leave unset to keep browser STT.
# Audio is never stored. Production requires HTTPS when this is enabled.
# VOICE_STT_API_URL=https://speech.example.edu/transcribe
# VOICE_STT_API_KEY=

# Google Sign-In. Same Web client ID as frontend VITE_GOOGLE_CLIENT_ID.
# Required when APP_ENV=production.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Comma-separated browser origins. Required when APP_ENV=production. Do not use *.
# CORS_ALLOWED_ORIGINS=https://schemewise.example.edu

# Optional directory for non-sensitive supporting uploads. Never store Aadhaar or PAN.
# SUPPORTING_UPLOAD_DIR=var/supporting_uploads
